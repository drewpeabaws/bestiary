# bestiary-backend env example
# Copy to .env (gitignored) and fill in values. Generated by Codiak /env-setup v0.1.2.

# === FastAPI runtime ===
APP_HOST=0.0.0.0
APP_PORT=8000
CORS_ORIGINS=http://localhost:3000

# === pydantic-settings (12-factor config) ===
ENV=dev
LOG_LEVEL=info

# === SQLAlchemy + Alembic (lands fully in BUR-13/BUR-14) ===
DATABASE_URL=postgresql+asyncpg://bestiary:bestiary_dev@localhost:5432/bestiary_dev

# === JWT auth (lands in BUR-15) ===
JWT_SECRET_KEY=REPLACE_ME_LOCAL_DEV_SECRET_GENERATE_WITH_OPENSSL_RAND
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=60

# === Password hashing ===
BCRYPT_ROUNDS=12

# === APScheduler (lands in BUR-16) ===
SCHEDULER_ENABLED=true
SCHEDULER_TIMEZONE=UTC

# === HTTPX (external HTTP client) ===
HTTP_TIMEOUT_SECONDS=30
HTTP_MAX_RETRIES=3
