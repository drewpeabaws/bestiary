# bestiary-backend Makefile
# Generated by Codiak /env-setup v0.1.2.

.PHONY: setup dev test lint build clean docker-up docker-down help

SHELL := /bin/bash

setup:  ## Install dependencies + initialize env
	cp -n .env.example .env || true
	uv sync --all-extras

dev:  ## Run dev server (FastAPI via uvicorn with hot-reload)
	uv run uvicorn app.main:app --host $${APP_HOST:-0.0.0.0} --port $${APP_PORT:-8000} --reload

test:  ## Run tests
	uv run pytest -v

lint:  ## Lint + format check
	uv run ruff check .
	uv run ruff format --check .

build:  ## Build (no-op for FastAPI; placeholder for container build)
	@echo "No build step required for FastAPI dev. For container, see Dockerfile (added later)."

clean:  ## Clean build artifacts
	rm -rf __pycache__ .pytest_cache .ruff_cache *.egg-info dist build

docker-up:  ## Start docker services (none currently — BUR-13 will add Postgres)
	@echo "No docker-compose.yml services to start. BUR-13 lands Postgres."

docker-down:  ## Stop docker services
	@echo "No docker-compose.yml services to stop."

help:  ## List available targets
	@grep -E '^[a-zA-Z_-]+:.*?## .*$$' $(MAKEFILE_LIST) | awk 'BEGIN {FS = ":.*?## "}; {printf "\033[36m%-15s\033[0m %s\n", $$1, $$2}'
